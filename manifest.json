{
  "manifest_version": 3,
  "name": "Reply Click Tracker",
  "version": "4.0.6",
  "permissions": [
    "storage",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "https://iap-support.babylone.joom.it/*",
    "https://babylone.joom.it/*",
    "https://babylone-api.joom.it/*",
    "https://support.joom.it/*",
    "https://api-support.joom.it/*"
  ],
  "options_page": "settings.html",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://babylone.joom.it/*",
        "https://iap-support.babylone.joom.it/*",
        "https://support.joom.it/*"
      ],
      "css": [
        "content-styles.css"
      ],
      "js": [
        "vendor/libphonenumber-js.min.js",
        "content/utils/id-parsers.js",
        "content/utils/phone-utils.js",
        "content/utils/sheet-utils.js",
        "content/utils/ticket-order-locators.js",
        "content/utils/api-helpers.js",
        "content/utils/locale.js",
        "content/features/media-picker.js",
        "content/features/order-flags.js",
        "content/features/tracking.js",
        "content/features/navbar-stats.js",
        "content/features/order-details-enhancements.js",
        "content/features/merchant-charity.js",
        "content/features/agent-info.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
